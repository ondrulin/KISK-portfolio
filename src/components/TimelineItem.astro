---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Calendar from '@lucide/astro/icons/calendar';
import PenTool from '@lucide/astro/icons/pen-tool';

interface Props {
  company: string;
  role: string;
  period: string;
  workload?: string;
  logo?: ImageMetadata;
  summary?: string;
  isCurrent?: boolean;
}

const {
  company,
  role,
  period,
  workload,
  logo,
  summary,
  isCurrent = false,
} = Astro.props;
---

<li class="group/timeline relative flex gap-4 pb-8 last:pb-0 sm:gap-6">
  <!-- Vertical timeline connector & company icon -->
  <div class="relative flex flex-col items-center">
    {
      logo ? (
        <div class="z-10 h-12 w-12 shrink-0 overflow-hidden rounded-xl border border-line bg-bg">
          <Image
            src={logo}
            alt={`${company} ikona`}
            widths={[48, 96]}
            sizes="48px"
            format="webp"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      ) : (
        <div class="z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-accent-border bg-accent-soft text-ink">
          <PenTool class="h-5 w-5" stroke-width={1.75} aria-hidden="true" />
        </div>
      )
    }
    <span class="mt-2 w-px flex-1 bg-line group-last/timeline:hidden" aria-hidden="true" />
  </div>

  <!-- Role card -->
  <article class="flex-1 rounded-3xl border border-line bg-bg p-5 sm:p-7">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint">
          {company}
        </p>
        <h3 class="mt-0.5 font-display text-xl font-semibold text-ink sm:text-[1.375rem]">
          {role}
        </h3>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2.5 sm:justify-end">
        {
          workload && (
            <span class="rounded-md border border-accent-border bg-accent-soft px-2 py-0.5 text-xs font-medium text-ink">
              {workload}
            </span>
          )
        }
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-faint">
          {isCurrent ? (
            <span class="h-2 w-2 rounded-full bg-accent-strong" aria-hidden="true" />
          ) : (
            <Calendar class="h-3.5 w-3.5" stroke-width={1.75} aria-hidden="true" />
          )}
          <span>{period}</span>
        </span>
      </div>
    </div>

    {
      summary && (
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-soft" set:html={summary} />
      )
    }

    <div class="mt-4 text-[0.9375rem] leading-relaxed text-ink-soft">
      <slot />
    </div>
  </article>
</li>
