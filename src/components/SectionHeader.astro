---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  as?: 'h1' | 'h2';
  animate?: boolean;
}

const {
  eyebrow,
  title,
  description,
  as = 'h1',
  animate = true,
} = Astro.props;

const HeadingTag = as;
---

<header class:list={['max-w-[680px]', animate && 'animate-section']}>
  {
    eyebrow && (
      <span class="inline-flex items-center gap-2 rounded-md border border-accent-border bg-accent-soft px-2.5 py-1 text-xs font-medium text-ink">
        <slot name="icon">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-strong" aria-hidden="true" />
        </slot>
        <span>{eyebrow}</span>
      </span>
    )
  }
  <HeadingTag
    class:list={[
      'font-display font-semibold text-ink',
      eyebrow ? 'mt-3' : '',
      as === 'h1' ? 'text-3xl leading-[1.12] sm:text-4xl' : 'text-2xl leading-[1.2] sm:text-[1.75rem]',
    ]}
  >
    {title}
  </HeadingTag>
  {
    description && (
      <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-[1.0625rem]">
        {description}
      </p>
    )
  }
</header>
