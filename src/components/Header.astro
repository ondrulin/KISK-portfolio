---
import Menu from '@lucide/astro/icons/menu';

export type NavKey = 'home' | 'study' | 'work' | 'about';

interface Props {
  activeNav: NavKey;
}

const { activeNav } = Astro.props;

const navItems: Array<{ key: NavKey; label: string; href: string }> = [
  { key: 'home', label: 'Domů', href: '/' },
  { key: 'study', label: 'Studium', href: '/studium' },
  { key: 'work', label: 'Práce', href: '/prace' },
  { key: 'about', label: 'O mně', href: '/o-mne' },
];
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/92 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[880px] items-center justify-between gap-4 px-5 sm:px-8">
    <a
      href="/"
      class="font-display text-[1.0625rem] font-semibold tracking-[-0.03em] text-ink transition-opacity hover:opacity-75"
    >
      Ondřej Schwarz
    </a>

    <!-- Desktop pill navigation -->
    <nav aria-label="Hlavní navigace" class="hidden items-center gap-1 rounded-full border border-line bg-surface p-1 sm:flex">
      {
        navItems.map((item) => {
          const isActive = item.key === activeNav;
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-medium transition-all duration-150',
                isActive
                  ? 'border border-line bg-bg text-ink shadow-[0_1px_2px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.03)]'
                  : 'border border-transparent text-ink-soft hover:text-ink',
              ]}
            >
              {isActive && <span class="h-1.5 w-1.5 rounded-full bg-accent-strong" aria-hidden="true" />}
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <!-- Zero-JS mobile disclosure navigation -->
    <details class="relative sm:hidden">
      <summary
        class="flex cursor-pointer items-center gap-2 rounded-full border border-line-strong bg-bg px-3.5 py-1.5 text-sm font-medium text-ink shadow-[0_1px_2px_rgba(0,0,0,0.04)] transition-colors hover:border-ink"
        aria-label="Otevřít navigaci"
      >
        <span>Menu</span>
        <Menu class="h-4 w-4 text-ink" stroke-width={1.75} aria-hidden="true" />
      </summary>
      <nav
        aria-label="Mobilní navigace"
        class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded-2xl border border-line bg-bg p-2 shadow-[0_8px_24px_rgba(0,0,0,0.08)]"
      >
        {
          navItems.map((item) => {
            const isActive = item.key === activeNav;
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium transition-colors',
                  isActive ? 'bg-accent-soft text-ink' : 'text-ink-soft hover:bg-surface hover:text-ink',
                ]}
              >
                {isActive && <span class="h-1.5 w-1.5 rounded-full bg-accent-strong" aria-hidden="true" />}
                <span>{item.label}</span>
              </a>
            );
          })
        }
      </nav>
    </details>
  </div>
</header>
