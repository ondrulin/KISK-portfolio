---
import { getCollection, render } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import ArrowDownRight from '@lucide/astro/icons/arrow-down-right';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import BookOpen from '@lucide/astro/icons/book-open';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Clock from '@lucide/astro/icons/clock';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const semesters = await getCollection('semesters');
  return semesters
    .filter((entry) => entry.data.status !== 'upcoming')
    .map((semester) => ({
      params: { slug: semester.data.slug },
      props: { semester },
    }));
}

const { semester } = Astro.props;
const { Content } = await render(semester);
const hasBody = Boolean(semester.body && semester.body.trim().length > 0);

const md = await createMarkdownProcessor();

const renderedCourses = await Promise.all(
  semester.data.courses.map(async (course) => {
    const reflectionHtml =
      course.reflection && course.reflection.trim().length > 0
        ? (await md.render(course.reflection)).code
        : null;

    return {
      ...course,
      anchorId: course.code.toLowerCase(),
      reflectionHtml,
    };
  }),
);

function formatCourseCount(count: number): string {
  if (count === 1) return '1 předmět';
  if (count >= 2 && count <= 4) return `${count} předměty`;
  return `${count} předmětů`;
}

const statusText = semester.data.status === 'completed' ? 'Dokončeno' : 'Probíhá';
---

<BaseLayout
  title={`${semester.data.title} (${semester.data.period}) · Studium · Ondřej Schwarz`}
  description={`Přehled předmětů a reflexí pro ${semester.data.title} (${semester.data.period}) magisterského studia na KISKu.`}
  activeNav="study"
>
  <!-- Breadcrumb Button (distinct rounded-full interactive button) -->
  <nav aria-label="Drobečková navigace" class="animate-section mb-6">
    <a
      href="/studium"
      class="group inline-flex items-center gap-2 rounded-full border border-line-strong bg-bg px-4 py-2 text-xs font-medium text-ink shadow-[0_1px_2px_rgba(0,0,0,0.04)] transition-colors hover:border-ink hover:bg-surface"
    >
      <ArrowLeft class="h-3.5 w-3.5 transition-transform duration-150 group-hover:-translate-x-0.5" stroke-width={1.75} aria-hidden="true" />
      <span>Zpět na přehled studia</span>
    </a>
  </nav>

  <!-- Semester Header (non-interactive metadata clearly distinguished from buttons) -->
  <header class="animate-section delay-1 max-w-[740px]">
    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-2 rounded-md border border-accent-border bg-accent-soft px-2.5 py-1 text-xs font-medium text-ink">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-strong" aria-hidden="true" />
        <span>{semester.data.period} · {statusText}</span>
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-faint">
        <BookOpen class="h-3.5 w-3.5" stroke-width={1.75} aria-hidden="true" />
        <span>{formatCourseCount(renderedCourses.length)}</span>
      </span>
    </div>

    <h1 class="mt-3.5 font-display text-3xl font-semibold leading-[1.12] text-ink sm:text-4xl">
      {semester.data.title}
    </h1>
    <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-[1.0625rem]">
      {semester.data.summary}
    </p>
  </header>

  <!-- Symmetrical 2-Column Jump-to-Course Grid -->
  {
    renderedCourses.length > 0 && (
      <nav
        aria-label="Rychlý skok na předměty"
        class="animate-section delay-2 mt-8 max-w-[740px] rounded-3xl border border-line bg-surface p-5 sm:p-6"
      >
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint">
            Předměty v tomto semestru
          </p>
          <span class="text-xs text-ink-faint">Kliknutím přeskočíš na detail</span>
        </div>

        <ul class="mt-3.5 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
          {renderedCourses.map((course) => (
            <li>
              <a
                href={`#${course.anchorId}`}
                class="group flex h-full w-full items-center justify-between gap-3 rounded-xl border border-line bg-bg px-3.5 py-2.5 transition-colors hover:border-ink/40 hover:bg-accent-soft/50"
              >
                <span class="flex min-w-0 items-center gap-2.5">
                  <span class="shrink-0 rounded-md bg-surface-muted px-2 py-0.5 text-xs font-semibold text-ink group-hover:bg-accent-soft">
                    {course.code}
                  </span>
                  <span class="truncate text-xs font-medium text-ink-soft group-hover:text-ink sm:text-[0.8125rem]">
                    {course.name}
                  </span>
                </span>
                <ArrowDownRight
                  class="h-3.5 w-3.5 shrink-0 text-ink-faint transition-transform duration-150 group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-hover:text-ink"
                  stroke-width={1.75}
                  aria-hidden="true"
                />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <!-- Optional overall semester reflection -->
  {
    hasBody && (
      <section class="prose-kisk animate-section delay-2 mt-10 max-w-[740px] rounded-3xl border border-line bg-bg p-6 sm:p-8" aria-label="Celkové zhodnocení semestru">
        <Content />
      </section>
    )
  }

  <!-- Sequential Course Reflections -->
  <div class="animate-section delay-3 mt-10 max-w-[740px] space-y-5">
    {
      renderedCourses.map((course) => (
        <section
          id={course.anchorId}
          class="scroll-mt-24 rounded-3xl border border-line bg-bg p-6 sm:p-8"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="rounded-md bg-surface-muted px-2.5 py-1 text-xs font-semibold tracking-wider text-ink">
              {course.code}
            </span>
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-faint">
              {course.status === 'completed' ? (
                <>
                  <CircleCheck class="h-3.5 w-3.5 text-ink" stroke-width={1.75} aria-hidden="true" />
                  <span class="text-ink">Reflexe doplněna</span>
                </>
              ) : (
                <>
                  <Clock class="h-3.5 w-3.5" stroke-width={1.75} aria-hidden="true" />
                  <span>Probíhá</span>
                </>
              )}
            </span>
          </div>

          <h2 class="mt-3 font-display text-xl font-semibold text-ink sm:text-2xl">
            {course.name}
          </h2>

          {course.reflectionHtml ? (
            <div class="prose-kisk mt-4" set:html={course.reflectionHtml} />
          ) : (
            <div class="mt-4 rounded-2xl border border-dashed border-line-strong bg-surface px-4 py-3.5 text-sm leading-relaxed text-ink-soft">
              Předmět právě probíhá. Reflexi a poznámky z výuky doplním po dokončení semestru.
            </div>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>
