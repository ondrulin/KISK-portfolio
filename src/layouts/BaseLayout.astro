---
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Header, { type NavKey } from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  activeNav: NavKey;
}

const { title, description, activeNav } = Astro.props;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-ink">
    <Header activeNav={activeNav} />
    <main class="mx-auto w-full max-w-[880px] flex-1 px-5 py-10 sm:px-8 sm:py-14">
      <slot />
    </main>
    <Footer />
  </body>
</html>
